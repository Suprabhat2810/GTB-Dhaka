JWT_SECRET=very_long_random_secret_here_replace_it
JWT_ALGO=HS256

# CORS: comma-separated list of allowed origins (no spaces). In development you can set '*'
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://gtbnc.co.in
# Optional Redis DSN
REDIS_DSN=redis://127.0.0.1:6379

# Storage Configuration
# APP_ENV: 'development' uses local storage, 'production' uses S3
APP_ENV=development
STORAGE_DRIVER=local

# AWS S3 Configuration (Required for production)
# When APP_ENV=production, set STORAGE_DRIVER=s3 and configure below
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET_NAME=gtb-student-documents
AWS_S3_URL=https://gtb-student-documents.s3.ap-south-1.amazonaws.com

# Twilio WhatsApp Configuration (Optional - for sending WhatsApp notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
INSTITUTE_NAME="Guru Tegh Bahadur College"
INSTITUTE_LOGO_URL="http://localhost:8080/logo.png"
